# Operadores aritmeticos e precedencia
a = 10;
b = 3;

print(a + b);
print(a - b);
print(a * b);
print(a / 4);
print(a % b);
print(2 + 3 * 4);
print((2 + 3) * 4);
print(-a + 5);
print(10 - (4 - 2));

# SAIDA: 13
# SAIDA: 7
# SAIDA: 30
# SAIDA: 2.5
# SAIDA: 1
# SAIDA: 14
# SAIDA: 20
# SAIDA: -5
# SAIDA: 8
